diff --git a/rich/console.py b/rich/console.py
index 5929fb1c..308e9a89 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -970,6 +970,16 @@ class Console:
             # ValueError: I/O operation on closed file
             # return False because we aren't in a terminal anymore
             return False
+    @property
+    def is_interactive(self) -> bool:
+        """Check if the console is interactive."""
+        environ = self._environ
+        tty_interactive = environ.get("TTY_INTERACTIVE", "")
+        if tty_interactive == "0":
+            return False
+        if tty_interactive == "1":
+            return True
+        return self.is_terminal
 
     @property
     def is_dumb_terminal(self) -> bool:
