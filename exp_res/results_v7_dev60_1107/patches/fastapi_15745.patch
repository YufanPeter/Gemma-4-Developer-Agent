+class RouterRoute(routing.Route):
+    def __init__(
+        self,
+        router: "APIRouter",
+        prefix: str,
+        tags: list[str] | None = None,
+        dependencies: Sequence[params.Depends] | None = None,
+        responses: dict[int | str, dict[str, Any]] | None = None,
+        deprecated: bool | None = None,
+        include_in_schema: bool = True,
+    ):
+        super().__init__(path=prefix, endpoint=router)
+        self.prefix = prefix
+        self.router = router
+        self.tags = tags
+        self.dependencies = dependencies
+        self.responses = responses
+        self.deprecated = deprecated
+        self.include_in_schema = include_in_schema
+
+    def matches(self, scope: Scope) -> tuple[Match, Scope]:
+        path = scope.get("path", "")
+        if path.startswith(self.prefix):
+            child_scope = scope.copy()
+            child_scope["path"] = path[len(self.prefix):]
+            if not child_scope["path"].startswith("/"):
+                child_scope["path"] = "/" + child_scope["path"]
+            match, final_scope = self.router.matches(child_scope)
+            if match != Match.NONE:
+                return match, final_scope
+        return Match.NONE, scope
+
+    async def handle(self, scope: Scope, receive: Receive, send: Send) -> None:
+        route = scope.get("route")
+        if route:
+            await route.handle(scope, receive, send)
+
