+from rich.console import Console
+from rich.live import Live
+import time
+
+console = Console(force_terminal=True)
+with Live("Hello World", console=console, auto_refresh=False) as live:
+    console.print("Start")
+    live.refresh()
+    time.sleep(0.1)
+    live.update("")
+    live.refresh()
+    time.sleep(0.1)
+    live.update("New Content")
+    live.refresh()