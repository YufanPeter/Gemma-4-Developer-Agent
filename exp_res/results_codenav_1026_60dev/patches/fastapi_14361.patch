diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..3bc1cccf
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,30 @@
+
+from fastapi._compat import v2
+from pydantic import BaseModel
+from pydantic.fields import FieldInfo
+from typing import Dict, Any, Tuple, Literal
+
+class MyModel(BaseModel):
+    x: int
+
+model_name_map = {MyModel: "MyModel"}
+field_info = FieldInfo(annotation=MyModel)
+field = v2.ModelField(name="foo", field_info=field_info)
+
+# schema without $ref
+field_mapping = {
+    (field, "validation"): {"title": "Foo"}
+}
+definitions = {}
+
+try:
+    v2._remap_definitions_and_field_mappings(
+        model_name_map=model_name_map,
+        definitions=definitions,
+        field_mapping=field_mapping
+    )
+    print("Success")
+except KeyError as e:
+    print(f"Caught expected KeyError: {e}")
+except Exception as e:
+    print(f"Caught unexpected exception: {type(e).__name__}: {e}")
