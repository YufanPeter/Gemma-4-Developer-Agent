+from pydantic import BaseModel, Field
+from fastapi import FastAPI
+
+app = FastAPI()
+
+class MyModel(BaseModel):
+    ref: str = Field(alias="$ref")
+
+@app.get("/", response_model=MyModel)
+def root():
+    return MyModel(ref="foo")
+
+try:
+    print(app.openapi())
+except Exception as e:
+    import traceback
+    traceback.print_exc()