@@ -0,0 +1,77 @@
+from typing import Any, Literal, Annotated
+from pydantic import BaseModel
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+
+class Pie(BaseModel):
+    time_to_cook: int
+    num_ingredients: int
+
+class ApplePie(Pie):
+    fruit: Literal["apple"] = "apple"
+
+class PumpkinPie(Pie):
+    filling: Literal["pumpkin"] = "pumpkin"
+
+def get_discriminator_value(v: Any) -> str:
+    if isinstance(v, dict):
+        return v.get("fruit", v.get("filling"))
+    return getattr(v, "fruit", getattr(v, "filling", None))
+
+# This is the problematic type
+# Note: Tag and Discriminator are from pydantic (or similar)
+# In the issue, they are used as:
+# Dessert = Annotated[
+#     Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")],
+#     Discriminator(get_discriminator_value),
+# ]
+# Wait, Tag and Discriminator are not standard pydantic. 
+# They might be from pydantic.fields or similar, or maybe the user meant something else.
+# Actually, Pydantic v2 has Discriminator.
+# Let's check what Tag and Discriminator are.
+# In Pydantic v2, Discriminator is in pydantic.fields.
+# Tag is not a standard Pydantic thing. Maybe it's a custom class?
+# Looking at the issue again, the user didn't import Tag and Discriminator.
+# They might be using a version of Pydantic or a library that provides them.
+# Actually, Pydantic v2 uses Discriminator.
+# Let's try to use Pydantic v2's Discriminator.
+
+from pydantic import Discriminator as PydanticDiscriminator
+
+# The user's example:
+# Dessert = Annotated[
+#     Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")],
+#     Discriminator(get_discriminator_value),
+# ]
+# If Tag is just a marker, let's define it.
+class Tag:
+    def __init__(self, value):
+        self.value = value
+
+Dessert = Annotated[
+    Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")],
+    PydanticDiscriminator(get_discriminator_value),
+]
+
+app = FastAPI()
+@app.post("/dessert")
+async def dinner(dessert: Dessert) -> dict[str, Any]:
+    return dessert.model_dump()
+
+client = TestClient(app)
+
+def test_reproduce():
+    # This should be a body parameter. If FastAPI thinks it's a query parameter,
+    # it will fail to find it in the body and might complain about missing query param
+    # or fail validation.
+    response = client.post("/dessert", json={"fruit": "apple", "time_to_cook": 10, "num_ingredients": 5})
+    print(f"Status code: {response.status_code}")
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_reproduce()
+        print("Success!")
+    except Exception as e:
+        print(f"Failed: {e}")