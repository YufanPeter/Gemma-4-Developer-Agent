+import pickle
+import json
+from requests.exceptions import JSONDecodeError
+
+def reproduce():
+    try:
+        # Create a JSONDecodeError
+        # json.JSONDecodeError(msg, doc, pos)
+        exc = JSONDecodeError("msg", "doc", 0)
+        print(f"Original exception: {exc}")
+        
+        # Pickle it
+        pickled = pickle.dumps(exc)
+        print("Pickled successfully")
+        
+        # Unpickle it
+        unpickled = pickle.loads(pickled)
+        print(f"Unpickled exception: {unpickled}")
+        
+        # Compare attributes
+        print(f"Original msg: {exc.msg}, Unpickled msg: {getattr(unpickled, 'msg', 'MISSING')}")
+        print(f"Original doc: {exc.doc}, Unpickled doc: {getattr(unpickled, 'doc', 'MISSING')}")
+        print(f"Original pos: {exc.pos}, Unpickled pos: {getattr(unpickled, 'pos', 'MISSING')}")
+        
+        assert exc.msg == unpickled.msg
+        assert exc.doc == unpickled.doc
+        assert exc.pos == unpickled.pos
+        print("Success: requests.exceptions.JSONDecodeError was deserialized correctly")
+        
+    except Exception as e:
+        print(f"Failure: {e}")
+        import traceback
+        traceback.print_exc()
+        raise e
+
+if __name__ == "__main__":
+    reproduce()