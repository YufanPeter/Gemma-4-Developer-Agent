+++ b/reproduction_script.py
@@ -0,0 +1,38 @@
+from fastapi import FastAPI
+from fastapi.openapi.utils import get_openapi
+from pydantic import BaseModel
+import json
+
+app = FastAPI()
+
+class NestedModel(BaseModel):
+    name: str
+
+class MainModel(BaseModel):
+    nested: NestedModel
+
+@app.post("/test")
+async def test_endpoint(item: MainModel):
+    return item
+
+openapi_schema = get_openapi(
+    title="Test API", 
+    version="1.0.0", 
+    routes=app.routes
+)
+definitions = openapi_schema.get("components", {}).get("schemas", {})
+
+print(json.dumps(definitions, indent=2))
+
+# Check if both NestedModel-Input and NestedModel-Output exist
+has_input = any("NestedModel-Input" in k for k in definitions.keys())
+has_output = any("NestedModel-Output" in k for k in definitions.keys())
+
+print(f"NestedModel-Input exists: {has_input}")
+print(f"NestedModel-Output exists: {has_output}")
+
+if has_input and has_output:
+    print("SUCCESS: Both Input and Output schemas exist for nested model.")
+else:
+    print("FAILURE: One or both schemas are missing for nested model.")
+    exit(1)