+++ b/reproduce_issue.py
@@ -0,0 +1,124 @@
+
+from fastapi import FastAPI, Query, Header, Cookie
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+
+app = FastAPI()
+
+class QueryModel(BaseModel):
+    foo_bar: str = Field(..., alias="foo-bar")
+
+@app.get("/query")
+async def read_query(q: QueryModel = Query()):
+    return q
+
+class HeaderModel(BaseModel):
+    foo_bar: str = Field(..., alias="foo-bar")
+
+@app.get("/header")
+async def read_header(h: HeaderModel = Header()):
+    return h
+
+class CookieModel(BaseModel):
+    foo_bar: str = Field(..., alias="foo-bar")
+
+@app.get("/cookie")
+async def read_cookie(c: CookieModel = Cookie()):
+    return c
+
+client = TestClient(app)
+
+def test_query_alias():
+    # Issue 1: Should work when passed by alias
+    response = client.get("/query", params={"foo-bar": "value"})
+    print(f"Query Alias Response: {response.status_code} {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"foo_bar": "value"}
+
+def test_query_name():
+    # Issue 2: Should return 422 and include foo_bar in input
+    response = client.get("/query", params={"foo_bar": "value"})
+    print(f"Query Name Response: {response.status_code} {response.text}")
+    assert response.status_code == 422
+    errors = response.json()["detail"]
+    # Check if foo_bar is in the input of the error
+    # The error should be for missing 'foo-bar'
+    # and 'foo_bar' should be in the input
+    found_extra = False
+    for error in errors:
+        if "input" in error and "foo_bar" in error["input"]:
+            found_extra = True
+    assert found_extra, f"foo_bar should be in input, got {errors}"
+
+def test_header_alias():
+    response = client.get("/header", headers={"foo-bar": "value"})
+    print(f"Header Alias Response: {response.status_code} {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"foo_bar": "value"}
+
+def test_header_name():
+    response = client.get("/header", headers={"foo_bar": "value"})
+    print(f"Header Name Response: {response.status_code} {response.text}")
+    assert response.status_code == 422
+    errors = response.json()["detail"]
+    found_extra = False
+    for error in errors:
+        if "input" in error and "foo_bar" in error["input"]:
+            found_extra = True
+    assert found_extra, f"foo_bar should be in input, got {errors}"
+
+def test_cookie_alias():
+    client.cookies.set("foo-bar", "value")
+    response = client.get("/cookie")
+    print(f"Cookie Alias Response: {response.status_code} {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"foo_bar": "value"}
+
+def test_cookie_name():
+    client.cookies.set("foo_bar", "value")
+    response = client.get("/cookie")
+    print(f"Cookie Name Response: {response.status_code} {response.text}")
+    assert response.status_code == 422
+    errors = response.json()["detail"]
+    found_extra = False
+    for error in errors:
+        if "input" in error and "foo_bar" in error["input"]:
+            found_extra = True
+    assert found_extra, f"foo_bar should be in input, got {errors}"
+
+if __name__ == "__main__":
+    try:
+        test_query_alias()
+        print("test_query_alias passed")
+    except Exception as e:
+        print(f"test_query_alias failed: {e}")
+
+    try:
+        test_query_name()
+        print("test_query_name passed")
+    except Exception as e:
+        print(f"test_query_name failed: {e}")
+
+    try:
+        test_header_alias()
+        print("test_header_alias passed")
+    except Exception as e:
+        print(f"test_header_alias failed: {e}")
+
+    try:
+        test_header_name()
+        print("test_header_name passed")
+    except Exception as e:
+        print(f"test_header_name failed: {e}")
+
+    try:
+        test_cookie_alias()
+        print("test_cookie_alias passed")
+    except Exception as e:
+        print(f"test_cookie_alias failed: {e}")
+
+    try:
+        test_cookie_name()
+        print("test_cookie_name passed")
+    except Exception as e:
+        print(f"test_cookie_name failed: {e}")