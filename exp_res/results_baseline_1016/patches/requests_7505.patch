diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..88e160e1
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,36 @@
+
+from src.requests._types import is_supports_read, is_supports_items
+from typing import Protocol
+
+class SupportsRead(Protocol):
+    def read(self, *args, **kwargs): ...
+
+class SupportsItems(Protocol):
+    def items(self, *args, **kwargs): ...
+
+class MockRead:
+    def read(self, *args, **kwargs): return b"data"
+
+class MockItems:
+    def items(self, *args, **kwargs): return [("a", 1)]
+
+class NotSupportsRead:
+    def other(self): pass
+
+class NotSupportsItems:
+    def other(self): pass
+
+def test_is_supports_read():
+    assert is_supports_read(MockRead()) is True
+    assert is_supports_read(NotSupportsRead()) is False
+    print("test_is_supports_read passed")
+
+def test_is_supports_items():
+    assert is_supports_items(MockItems()) is True
+    assert is_supports_items(NotSupportsItems()) is False
+    print("test_is_supports_items passed")
+
+if __name__ == "__main__":
+    test_is_supports_read()
+    test_is_supports_items()
+    print("All tests passed!")