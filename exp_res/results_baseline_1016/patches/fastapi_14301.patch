--- /dev/null
+++ b/repro.py
@@ -0,0 +1,44 @@
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+call_count = 0
+
+def common_dep():
+    global call_count
+    call_count += 1
+    print(f"common_dep called, count={call_count}")
+    return "common"
+
+def dep1(common=Depends(common_dep, scope="function")):
+    print(f"dep1 called")
+    return common
+
+def dep2(common=Depends(common_dep, scope="function")):
+    print(f"dep2 called")
+    return common
+
+@app.get("/", dependencies=[])
+def read_root(d1=Depends(dep1), d2=Depends(dep2)):
+    return {"hello": "world"}
+
+client = TestClient(app)
+
+def test_dependency_scope_function():
+    global call_count
+    call_count = 0
+    
+    response = client.get("/")
+    assert response.status_code == 200
+    print(f"Call count: {call_count}")
+    # Expected: 3 if scope="function" works, 1 if it's treated as "request"
+    assert call_count == 3
+
+if __name__ == "__main__":
+    try:
+        test_dependency_scope_function()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed! Call count was {call_count}")
+        raise e