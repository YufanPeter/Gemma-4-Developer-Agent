+from __future__ import annotations
+import inspect
+from fastapi.dependencies.utils import get_typed_signature
+
+def my_endpoint(item: Item):
+    return item
+
+sig = get_typed_signature(my_endpoint)
+for param in sig.parameters.values():
+    print(f"Param: {param.name}, Annotation: {param.annotation}, Type: {type(param.annotation)}")
+
+if isinstance(sig.parameters['item'].annotation, str):
+    print("FAILED: Annotation is still a string")
+elif hasattr(sig.parameters['item'].annotation, '__forward_arg__'):
+    print("FAILED: Annotation is a ForwardRef")
+else:
+    print("SUCCESS: Annotation is resolved")