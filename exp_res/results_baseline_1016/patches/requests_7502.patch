new file mode 100644
index 00000000..edc2b64f
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,35 @@
+
+from typing import Protocol, runtime_checkable
+import requests
+from requests.models import Request
+
+@runtime_checkable
+class SupportsRead(Protocol):
+    def read(self, length=None): ...
+
+class Wrapper:
+    def __getattr__(self, name):
+        if name == 'read':
+            return lambda length=None: b"content"
+        raise AttributeError
+
+def test_getattr_wrapper():
+    w = Wrapper()
+    # This is what _encode_files does internally (via _SupportsRead)
+    # We can simulate it by calling _encode_files via a request
+    files = {'file': w}
+    # We need a Request object to call _encode_files, or just call it on a dummy object
+    # Since _encode_files is a method of RequestEncodingMixin (which Request inherits from)
+    # we can use a Request object.
+    req = Request('GET', 'http://example.com', files=files)
+    # Request.__init__ doesn't call _encode_files, it's called during preparation.
+    # Let's see where _encode_files is called.
+    # In Request.prepare(), it calls self.prepare_body() which calls self._encode_files()
+    try:
+        req.prepare()
+        print("Successfully prepared request with __getattr__ wrapper")
+    except Exception as e:
+        print(f"Failed to prepare request: {e}")
+
+if __name__ == "__main__":
+    test_getattr_wrapper()
