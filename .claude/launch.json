{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trace-platform",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "trace_platform.server",
        "--token",
        "local-dev-token"
      ],
      "port": 8790
    },
    {
      "name": "trace-live",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/trace_live.sh"
      ],
      "port": 8790
    }
  ]
}
